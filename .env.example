# Browser-safe Supabase project settings
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional browser AI hints. Prefer moving this call to an Edge Function before production.
VITE_OPENROUTER_API_KEY="your-openrouter-key"
VITE_OPENROUTER_MODEL="minimax/minimax-m2.5:free"

# Supabase Edge Function secret; configure with `supabase secrets set`.
FIRECRAWL_API_KEY="your-firecrawl-key"
